# Copy to .env. Everything is optional: with no settings the app runs in no-LLM mode.
# LLM_PROVIDER: extractive | anthropic | openai | ollama
LLM_PROVIDER=extractive
# Blank model = claude-haiku-5-5 / gpt-4o-mini / qwen2.5:1.5b
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_URL=http://localhost:11434

CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=5
MIN_RELEVANCE=0.65
MAX_FILE_MB=20
